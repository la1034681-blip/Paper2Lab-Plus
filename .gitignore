# ---- 千万别提交的东西 ----
# 密钥：部署走平台 Secrets / 环境变量注入，.env 只留在本机
.env
.env.*
!.env.example

# 环境与缓存（.venv 有 500MB+，推上去没意义还可能被拒）
.venv/
__pycache__/
*.pyc
cache/
.streamlit/secrets.toml

# 与线上应用无关的本地产物
output/
_publish/
_archive/
.trash_tmp/
.deploy/
*.log

# 技能包打包产物（tools/pack_skill.py 产出，属生成物）
# 技能源文件本身在 skills/ 下，**要进仓库** —— 那是交付内容，不是产物
dist/

# deploy/ 是 make_deploy.py 生成的**上线裁剪包**（自带独立 .git 与远端）
# 它是生成物、且内容与根目录重复，因此不进本仓库
deploy/

# AI 助手的工作记忆（每日开发日志 / 自动化笔记）——属于工具数据，不是工程内容
.workbuddy/

# 测试集与报告产物（体积大、且只在本地跑回归时才需要）
Paper2Lab测试集/
Paper2Lab测试集_v2/

# 两个验证脚本的 stdout 重定向产物（verify_memory_capacity.py / verify_phase23.py
# 把结果写到了工程根，纯本地台账，跟线上应用无关）
_memc.txt
_p23.txt
